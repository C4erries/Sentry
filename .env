# 🔌 Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_ADDR=zookeeper:${ZOOKEEPER_CLIENT_PORT}
# 🟠 Kafka
KAFKA_PORT=9092
KAFKA_ADDR=kafka:${KAFKA_PORT}
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=${ZOOKEEPER_ADDR}
KAFKA_LISTENERS=INTERNAL://0.0.0.0:${KAFKA_PORT}
KAFKA_ADVERTISED_LISTENERS=INTERNAL://${KAFKA_ADDR}
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# 🧭 Kafka UI
KAFKA_UI_PORT=8090
KAFKA_UI_NAME=local
KAFKA_UI_BOOTSTRAPSERVERS=${KAFKA_ADDR}
KAFKA_UI_ZOOKEEPER=${ZOOKEEPER_ADDR}

# 🟥 Redis
REDIS_PORT=6379
REDIS_ADDR=redis:${REDIS_PORT}

# 🟦 PostgreSQL
POSTGRES_USER=sentry
POSTGRES_PASSWORD=sentrypass
POSTGRES_DB=sentry_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# 🛡️ Sentry (Go-сервис)
SENTRY_PORT=8080